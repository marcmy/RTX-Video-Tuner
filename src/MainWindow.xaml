<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="RTX Video Tuner"
        Width="900" Height="760" MinWidth="760" MinHeight="650"
        WindowStartupLocation="CenterScreen"
        Background="#111318" Foreground="#F4F6F8"
        FontFamily="Segoe UI Variable Text, Segoe UI"
        UseLayoutRounding="True">
    <Window.Resources>
        <SolidColorBrush x:Key="PanelBrush" Color="#1A1E25" />
        <SolidColorBrush x:Key="PanelHoverBrush" Color="#20252D" />
        <SolidColorBrush x:Key="BorderBrush" Color="#313844" />
        <SolidColorBrush x:Key="MutedBrush" Color="#A8B0BC" />
        <SolidColorBrush x:Key="AccentBrush" Color="#76B900" />
        <SolidColorBrush x:Key="AccentHoverBrush" Color="#88D100" />

        <Style TargetType="TextBlock">
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
        <Style TargetType="Button">
            <Setter Property="Foreground" Value="#F4F6F8" />
            <Setter Property="Background" Value="#262C35" />
            <Setter Property="BorderBrush" Value="#3A424F" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="15,9" />
            <Setter Property="Margin" Value="0,0,8,0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Border" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="7" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Border" Property="Background" Value="#313844" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Border" Property="Background" Value="#20252D" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.45" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="{StaticResource AccentBrush}" />
            <Setter Property="Foreground" Value="#10130B" />
            <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Border" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="7" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Border" Property="Background" Value="{StaticResource AccentHoverBrush}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Border" Property="Opacity" Value="0.8" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.45" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="ComboBoxItem">
            <Setter Property="Foreground" Value="#F4F6F8" />
            <Setter Property="Background" Value="#151920" />
            <Setter Property="Padding" Value="10,8" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBoxItem">
                        <Border x:Name="ItemBorder"
                                Background="{TemplateBinding Background}"
                                Padding="{TemplateBinding Padding}"
                                SnapsToDevicePixels="True">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="ItemBorder" Property="Background" Value="#2B323D" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="ItemBorder" Property="Background" Value="#34431C" />
                                <Setter Property="Foreground" Value="#F4F6F8" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.45" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="ComboBox">
            <Setter Property="Foreground" Value="#F4F6F8" />
            <Setter Property="Background" Value="#20252D" />
            <Setter Property="BorderBrush" Value="#3A424F" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="10,7" />
            <Setter Property="MinHeight" Value="36" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Auto" />
            <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <Border x:Name="ControlBorder"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="4"
                                    SnapsToDevicePixels="True" />
                            <Grid Margin="{TemplateBinding Padding}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="18" />
                                </Grid.ColumnDefinitions>
                                <ContentPresenter x:Name="ContentSite"
                                                  Grid.Column="0"
                                                  Margin="0,0,8,0"
                                                  HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                                  VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                                  Content="{TemplateBinding SelectionBoxItem}"
                                                  ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                                  ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}"
                                                  IsHitTestVisible="False"
                                                  SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}" />
                                <Path Grid.Column="1"
                                      HorizontalAlignment="Center"
                                      VerticalAlignment="Center"
                                      Data="M 0 0 L 4 4 L 8 0 Z"
                                      Fill="#C9CED6"
                                      IsHitTestVisible="False" />
                            </Grid>
                            <ToggleButton x:Name="DropDownToggle"
                                          Background="Transparent"
                                          BorderThickness="0"
                                          ClickMode="Press"
                                          Focusable="False"
                                          IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"
                                          OverridesDefaultStyle="True">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border Background="Transparent" />
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>
                            <Popup x:Name="PART_Popup"
                                   AllowsTransparency="True"
                                   Focusable="False"
                                   IsOpen="{TemplateBinding IsDropDownOpen}"
                                   Placement="Bottom"
                                   PopupAnimation="Fade">
                                <Border x:Name="DropDownBorder"
                                        MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}"
                                        MaxHeight="{TemplateBinding MaxDropDownHeight}"
                                        Margin="0,3,0,0"
                                        Background="#151920"
                                        BorderBrush="#3A424F"
                                        BorderThickness="1"
                                        CornerRadius="4"
                                        SnapsToDevicePixels="True">
                                    <ScrollViewer Margin="1"
                                                  CanContentScroll="True"
                                                  SnapsToDevicePixels="True">
                                        <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Contained" />
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ControlBorder" Property="Background" Value="#262C35" />
                                <Setter TargetName="ControlBorder" Property="BorderBrush" Value="#4A5564" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                <Setter TargetName="ControlBorder" Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                            </Trigger>
                            <Trigger Property="IsDropDownOpen" Value="True">
                                <Setter TargetName="ControlBorder" Property="Background" Value="#262C35" />
                                <Setter TargetName="ControlBorder" Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                            </Trigger>
                            <Trigger Property="HasItems" Value="False">
                                <Setter TargetName="DropDownBorder" Property="MinHeight" Value="32" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="ControlBorder" Property="Background" Value="#1A1E25" />
                                <Setter TargetName="ControlBorder" Property="BorderBrush" Value="#313844" />
                                <Setter Property="Foreground" Value="#858D99" />
                                <Setter Property="Opacity" Value="0.78" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Foreground" Value="#F4F6F8" />
            <Setter Property="Background" Value="#151920" />
            <Setter Property="BorderBrush" Value="#3A424F" />
            <Setter Property="Padding" Value="9,6" />
            <Setter Property="MinHeight" Value="34" />
        </Style>
        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="#F4F6F8" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Margin" Value="0,4" />
        </Style>
        <Style TargetType="RadioButton">
            <Setter Property="Foreground" Value="#F4F6F8" />
            <Setter Property="Margin" Value="0,4,18,4" />
        </Style>
        <Style TargetType="Slider">
            <Setter Property="Foreground" Value="{StaticResource AccentBrush}" />
            <Setter Property="Margin" Value="0,4" />
        </Style>
        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource PanelBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="11" />
            <Setter Property="Padding" Value="20" />
            <Setter Property="Margin" Value="0,0,0,14" />
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="#151920" BorderBrush="#2B313B" BorderThickness="0,0,0,1" Padding="24,19">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="330" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <StackPanel Orientation="Horizontal">
                        <Border Width="36" Height="36" CornerRadius="8" Background="{StaticResource AccentBrush}" Margin="0,0,12,0">
                            <TextBlock Text="RTX" Foreground="#10130B" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="12" />
                        </Border>
                        <StackPanel>
                            <TextBlock Text="RTX Video Tuner" FontSize="22" FontWeight="SemiBold" />
                            <TextBlock Text="The useful NVIDIA App video controls, without the NVIDIA App." Foreground="{StaticResource MutedBrush}" Margin="0,2,0,0" />
                        </StackPanel>
                    </StackPanel>
                </StackPanel>
                <StackPanel Grid.Column="1">
                    <TextBlock Text="NVIDIA adapter" Foreground="{StaticResource MutedBrush}" Margin="0,0,0,6" />
                    <ComboBox x:Name="AdapterCombo" DisplayMemberPath="DisplayLabel" />
                </StackPanel>
            </Grid>
        </Border>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel Margin="24,20,24,18">
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="Video Super Resolution" FontSize="18" FontWeight="SemiBold" />
                                <TextBlock Text="Upscales video and reduces compression artifacts using RTX Tensor cores." Foreground="{StaticResource MutedBrush}" Margin="0,4,0,0" />
                            </StackPanel>
                            <CheckBox x:Name="VsrEnabledCheck" Grid.Column="1" Content="Enabled" FontWeight="SemiBold" />
                        </Grid>

                        <StackPanel x:Name="VsrSettingsPanel" Margin="0,18,0,0">
                            <TextBlock Text="Quality mode" FontWeight="SemiBold" />
                            <StackPanel Orientation="Horizontal" Margin="0,6,0,12">
                                <RadioButton x:Name="AutoModeRadio" GroupName="VsrMode" Content="Auto" />
                                <RadioButton x:Name="ManualModeRadio" GroupName="VsrMode" Content="Manual" />
                            </StackPanel>

                            <Grid x:Name="AutoPriorityPanel" Margin="0,0,0,6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="190" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="88" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                    <TextBlock Text="GPU priority" FontWeight="SemiBold" />
                                    <TextBlock Text="Reserve less or allow maximum RTX VSR quality." Foreground="{StaticResource MutedBrush}" FontSize="12" />
                                </StackPanel>
                                <Slider x:Name="GpuPrioritySlider" Grid.Column="1" Minimum="0" Maximum="2" TickFrequency="1" IsSnapToTickEnabled="True" VerticalAlignment="Center" />
                                <TextBlock x:Name="GpuPriorityValue" Grid.Column="2" Text="High" HorizontalAlignment="Right" VerticalAlignment="Center" FontWeight="SemiBold" />
                            </Grid>

                            <Grid x:Name="ManualQualityPanel" Margin="0,0,0,6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="190" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="88" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                    <TextBlock Text="Quality level" FontWeight="SemiBold" />
                                    <TextBlock Text="Higher quality uses more GPU resources." Foreground="{StaticResource MutedBrush}" FontSize="12" />
                                </StackPanel>
                                <Slider x:Name="ManualQualitySlider" Grid.Column="1" Minimum="1" Maximum="4" TickFrequency="1" IsSnapToTickEnabled="True" VerticalAlignment="Center" />
                                <TextBlock x:Name="ManualQualityValue" Grid.Column="2" Text="4" HorizontalAlignment="Right" VerticalAlignment="Center" FontWeight="SemiBold" />
                            </Grid>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="RTX Video HDR" FontSize="18" FontWeight="SemiBold" />
                                <TextBlock Text="Converts SDR video to HDR10. Windows HDR must be enabled for the target display." Foreground="{StaticResource MutedBrush}" Margin="0,4,0,0" />
                            </StackPanel>
                            <CheckBox x:Name="HdrEnabledCheck" Grid.Column="1" Content="Enabled" FontWeight="SemiBold" />
                        </Grid>

                        <Grid Margin="0,16,0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="190" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                <TextBlock Text="Display output" FontWeight="SemiBold" />
                                <TextBlock Text="HDR tuning is stored per NVIDIA output." Foreground="{StaticResource MutedBrush}" FontSize="12" />
                            </StackPanel>
                            <ComboBox x:Name="OutputCombo" Grid.Column="1" DisplayMemberPath="Label" />
                        </Grid>

                        <StackPanel x:Name="HdrSettingsPanel" Margin="0,12,0,0">
                            <Grid Margin="0,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="190" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="92" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                    <TextBlock Text="Peak brightness" FontWeight="SemiBold" />
                                    <TextBlock Text="Target highlight ceiling in nits." Foreground="{StaticResource MutedBrush}" FontSize="12" />
                                </StackPanel>
                                <Slider x:Name="PeakSlider" Grid.Column="1" Minimum="200" Maximum="2000" TickFrequency="50" IsSnapToTickEnabled="False" VerticalAlignment="Center" />
                                <TextBox x:Name="PeakValue" Grid.Column="2" HorizontalContentAlignment="Right" VerticalContentAlignment="Center" ToolTip="200–2000 nits" />
                            </Grid>

                            <Grid Margin="0,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="190" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="92" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                    <TextBlock Text="Middle grey" FontWeight="SemiBold" />
                                    <TextBlock Text="Controls overall exposure/paper white." Foreground="{StaticResource MutedBrush}" FontSize="12" />
                                </StackPanel>
                                <Slider x:Name="MidSlider" Grid.Column="1" Minimum="10" Maximum="100" TickFrequency="5" IsSnapToTickEnabled="False" VerticalAlignment="Center" />
                                <TextBox x:Name="MidValue" Grid.Column="2" HorizontalContentAlignment="Right" VerticalContentAlignment="Center" ToolTip="10–100 nits" />
                            </Grid>

                            <Grid Margin="0,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="190" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="92" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                    <TextBlock Text="Contrast" FontWeight="SemiBold" />
                                    <TextBlock Text="Driver adjustment from -100% to +100%." Foreground="{StaticResource MutedBrush}" FontSize="12" />
                                </StackPanel>
                                <Slider x:Name="ContrastSlider" Grid.Column="1" Minimum="-100" Maximum="100" TickFrequency="5" IsSnapToTickEnabled="False" VerticalAlignment="Center" />
                                <TextBox x:Name="ContrastValue" Grid.Column="2" HorizontalContentAlignment="Right" VerticalContentAlignment="Center" ToolTip="-100 to +100 percent" />
                            </Grid>

                            <Grid Margin="0,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="190" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="92" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                    <TextBlock Text="Saturation" FontWeight="SemiBold" />
                                    <TextBlock Text="Driver adjustment from -100% to +100%." Foreground="{StaticResource MutedBrush}" FontSize="12" />
                                </StackPanel>
                                <Slider x:Name="SaturationSlider" Grid.Column="1" Minimum="-100" Maximum="100" TickFrequency="5" IsSnapToTickEnabled="False" VerticalAlignment="Center" />
                                <TextBox x:Name="SaturationValue" Grid.Column="2" HorizontalContentAlignment="Right" VerticalContentAlignment="Center" ToolTip="-100 to +100 percent" />
                            </Grid>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource Card}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="Status indicator" FontSize="18" FontWeight="SemiBold" />
                            <TextBlock Text="Shows a small on-video indicator when RTX Video Super Resolution or RTX Video HDR is active. NVIDIA stores both indicators in one shared flag." Foreground="{StaticResource MutedBrush}" Margin="0,4,20,0" />
                        </StackPanel>
                        <CheckBox x:Name="IndicatorCheck" Grid.Column="1" Content="Show on video" FontWeight="SemiBold" />
                    </Grid>
                </Border>

                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="Recovery and diagnostics" FontSize="18" FontWeight="SemiBold" />
                        <TextBlock Text="A baseline backup is created automatically before the first write to each adapter." Foreground="{StaticResource MutedBrush}" Margin="0,4,0,14" />
                        <WrapPanel>
                            <Button x:Name="ExportButton" Content="Export settings .reg" />
                            <Button x:Name="RestoreButton" Content="Restore baseline" />
                            <Button x:Name="OpenRegistryButton" Content="Open adapter key" />
                            <Button x:Name="OpenHdrButton" Content="Windows HDR settings" />
                        </WrapPanel>
                        <TextBlock x:Name="RegistryPathText" Foreground="{StaticResource MutedBrush}" FontFamily="Cascadia Mono, Consolas" FontSize="11" Margin="0,14,0,0" TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <Border Grid.Row="2" Background="#151920" BorderBrush="#2B313B" BorderThickness="0,1,0,0" Padding="18,13">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                    <TextBlock x:Name="StatusText" Text="Ready" FontWeight="SemiBold" />
                    <TextBlock x:Name="StatusDetailText" Text="Changes may require a graphics-driver refresh or reboot before video apps see them." Foreground="{StaticResource MutedBrush}" FontSize="12" Margin="0,2,20,0" />
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Button x:Name="RefreshButton" Content="Reload" />
                    <Button x:Name="RestartDriverButton" Content="Restart graphics driver" />
                    <Button x:Name="ApplyButton" Content="Apply changes" Style="{StaticResource PrimaryButton}" Margin="0" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
